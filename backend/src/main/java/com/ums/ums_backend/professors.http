### ===== TOKEN SETUP =====
### Paste your tokens here after logging in (from auth.http)
### Format: @variable_name = token_value

@admin_token = 
@professor_token = 
@student_token = 

### ===== PROFESSOR ENDPOINTS =====
### This file contains all professor-related requests with role-based access tests
### Token Variables: @admin_token, @professor_token, @student_token

### Admin: Get all professors (ALLOWED)
GET http://localhost:8080/api/professors
Authorization: Bearer @admin_token

###

### Professor: Get all professors (ALLOWED)
GET http://localhost:8080/api/professors
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJwcm9mZXNzb3IxIiwiaWF0IjoxNzg1MzI3MDE5LCJleHAiOjE3ODUzMzA2MTl9.MJcyDBhis1M4QpiBdnb4BDynELOdcuqE9jA0iptf5Qg

###

### Student: Get all professors (DENIED - 403 Forbidden)
GET http://localhost:8080/api/professors
Authorization: Bearer @student_token

###

### Admin: Get professor by ID (ALLOWED)
GET http://localhost:8080/api/professors/1
Authorization: Bearer @admin_token

###

### Professor: Get professor by ID (ALLOWED)
GET http://localhost:8080/api/professors/1
Authorization: Bearer @professor_token

###

### Student: Get professor by ID (ALLOWED)
GET http://localhost:8080/api/professors/1
Authorization: Bearer @student_token

###

### Admin: Create professor (ALLOWED)
POST http://localhost:8080/api/professors
Content-Type: application/json
Authorization: Bearer @admin_token

{
  "id": 1,
  "userId": 1,
  "firstName": "Dr. Alice",
  "lastName": "Johnson",
  "gender": "FEMALE",
  "dateOfBirth": "1975-03-10",
  "email": "alice@university.edu"
}

###

### Professor: Create professor (DENIED - 403 Forbidden)
POST http://localhost:8080/api/professors
Content-Type: application/json
Authorization: Bearer @professor_token

{
  "id": 2,
  "userId": 2,
  "firstName": "Dr. Bob",
  "lastName": "Smith",
  "gender": "MALE",
  "dateOfBirth": "1972-05-20",
  "email": "bob@university.edu"
}

###

### Student: Create professor (DENIED - 403 Forbidden)
POST http://localhost:8080/api/professors
Content-Type: application/json
Authorization: Bearer @student_token

{
  "id": 3,
  "userId": 3,
  "firstName": "Dr. Carol",
  "lastName": "Davis",
  "gender": "FEMALE",
  "dateOfBirth": "1978-07-15",
  "email": "carol@university.edu"
}

###

### Admin: Update professor (ALLOWED)
PUT http://localhost:8080/api/professors/1
Content-Type: application/json
Authorization: Bearer @admin_token

{
  "id": 1,
  "userId": 1,
  "firstName": "Dr. Alice",
  "lastName": "Johnson-Updated",
  "gender": "FEMALE",
  "dateOfBirth": "1975-03-10",
  "email": "alice.updated@university.edu"
}

###

### Professor: Update professor (DENIED - 403 Forbidden)
PUT http://localhost:8080/api/professors/1
Content-Type: application/json
Authorization: Bearer @professor_token

{
  "id": 1,
  "userId": 1,
  "firstName": "Dr. Alice",
  "lastName": "Johnson-Modified",
  "gender": "FEMALE",
  "dateOfBirth": "1975-03-10",
  "email": "alice@university.edu"
}

###

### Admin: Delete professor (ALLOWED)
DELETE http://localhost:8080/api/professors/1
Authorization: Bearer @admin_token

###

### Professor: Delete professor (DENIED - 403 Forbidden)
DELETE http://localhost:8080/api/professors/1
Authorization: Bearer @professor_token

###
